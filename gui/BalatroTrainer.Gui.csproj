<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Use net8.0-windows if you only have the .NET 8 SDK installed. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>BalatroTrainer.Gui</RootNamespace>
    <AssemblyName>BalatroTrainer.Gui</AssemblyName>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
  </PropertyGroup>

  <!-- Copies the native backend next to the exe when it has been built (see README). -->
  <ItemGroup>
    <None Include="..\native\build\Release\BalatroTrainer.dll"
          Condition="Exists('..\native\build\Release\BalatroTrainer.dll')"
          Link="BalatroTrainer.dll"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
